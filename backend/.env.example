NODE_ENV=production
HOST=0.0.0.0
PORT=5000

MONGODB_URI=mongodb://localhost:27017/mamta-hospital-telemedicine

JWT_SECRET=some_strong_random_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:5174
ADMIN_URL=http://localhost:5173

# Cal.com Integration
# Generate your API key at: https://app.cal.com/settings/security/api-keys
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxx
# Default event type ID (used when doctor has no per-doctor calcomEventTypeId set)
CALCOM_BASE_URL=https://api.cal.com/v2
CALCOM_EVENT_TYPE_ID=0
# Set in Cal.com → Settings → Webhooks → Secret
CALCOM_WEBHOOK_SECRET=

# Cloudinary Image Upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
