NODE_ENV=production
HOST=0.0.0.0
PORT=5000

MONGODB_URI=mongodb://localhost:27017/mamta-hospital-telemedicine

JWT_SECRET=some_strong_random_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FRONTEND_URL=https://mamta-hospital-telemedicine.vercel.app/video-consultation
ADMIN_URL=http://localhost:5173

# ── Google OAuth 2.0 & Calendar Integration ───────────────────────────────────
# Step 1: Create OAuth credentials in Google Cloud Console
# Step 2: Set GOOGLE_REDIRECT_URI as shown below (must match Google Cloud Console exactly)
# Step 3: Visit https://mamta-hospital-telemedicine.onrender.com/api/auth/google
# Step 4: Grant permissions → check server logs for GOOGLE_REFRESH_TOKEN
# Step 5: Paste the token below and redeploy
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mamta-hospital-telemedicine.onrender.com/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Resend Email Integration ───────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mamta Superspeciality Hospital <onboarding@resend.dev>

# ── Cloudinary Image Upload ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
